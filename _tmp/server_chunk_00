def _compaction_targets_from_env():
    base = DEFAULT_CONTEXT_COMPACTION_URL
    model = DEFAULT_CONTEXT_COMPACTION_MODEL
    extra = os.environ.get("COMPACTION_TARGETS", "")  # comma-separated "url,model" pairs
    targets = [(base, model)]
    for part in extra.split(","):
        part = part.strip()
        if not part:
            continue
        if "," in part:
            u, m = part.split(",", 1)
            targets.append((u.strip(), m.strip()))
        else:
            targets.append((part, model))
    return targets

