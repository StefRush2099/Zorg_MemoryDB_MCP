# Zorg MemoryDB MCP - environment template
# Copy to .env and set real values. NEVER commit .env.

# --- db (postgres) ---
POSTGRES_PASSWORD=ChangeMe_StrongPassword
POSTGRES_USER=ollama_cpp_mcp

# --- MCP native token (memorydb-plugin) ---
POSTGRES_NATIVE_TOKEN=change-me-native-token

# --- LLM / compaction endpoints (override in .env or llm_registry) ---
# These are localhost defaults in server.py; point them at your real hosts.
# POSTGRES_MCP_SLOT_ENDPOINT=http://localhost:9001
# COMPACTION_ENDPOINT=http://localhost:11434/api/chat
